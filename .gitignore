# generic ignore pattern
**/*.ignore
**/*.ignore.*

# Default output of `dimos apriltag`
/apriltags.pdf

.vscode/

# Ignore Python cache files
__pycache__/
*.pyc

# Ignore virtual environment directories
*venv*/
.venv*/
.ssh/
.direnv/

# Ignore python tooling dirs
*.egg-info/
__pycache__

.env
**/.DS_Store

# Ignore default runtime output folder
/assets/output/
/assets/rgbd_data/
/assets/saved_maps/
/assets/model-cache/
/assets/agent/memory.txt

.bash_history

# Ignore all test data directories but allow compressed files
/data/*
!/data/.lfs/

# node env (used by devcontainers cli)
node_modules
package.json
package-lock.json
!docs/package.json
!docs/package-lock.json

# Ignore build artifacts
dist/
build/

# Ignore data directory but keep .lfs subdirectory
data/*
!data/.lfs/
FastSAM-x.pt
yolo11n.pt

/thread_monitor_report.csv

# symlink one of .envrc.* if you'd like to use
.envrc
.claude
**/CLAUDE.md
.direnv/

/logs

*.so

/.mypy_cache*

*mobileclip*
/results
results/
**/cpp/result

CLAUDE.MD
/assets/teleop_certs/

/.mcp.json
*.speedscope.json

# Coverage
htmlcov/
.coverage
.coverage.*

# Memory2 autorecord
recording*.db

# --- G1 scaffolding additions ---
*.tar
*.tar.gz
*.tgz
*.zip
*.zst
MUJOCO_LOG.TXT
*.log
**/chromadb_data/
**/visual_memory.pkl

# --- 巨大バイナリ / 生成物（誤 push 防止）---
# Isaac/MuJoCo シーンの USD。okra_field_full.usd 単体で 1.2GB あり、
# FARO スキャンから再生成できるため git には入れない（手順は docs 参照）。
usd_file/
# pyzed は ZED SDK 付属の wheel。SDK インストール時に生成されるので追跡しない。
*.whl
# rerun のレコーディング（g1_cam_mount.rrd 等）はスクリプトから再生成できる生成物。
*.rrd
# pyopenjtalk で生成する日本語アナウンス音声。ソース（文言）から再生成可能。
docs/sim-setup/audio_samples/

# --- oda/ZED_M_Depth_check: vendor SDK installers + YOLO finetune artifacts ---
# Keep only ZED_SDK_Install_Guide.md, zed_*.py, finetune/test/validate scripts.
oda/ZED_M_Depth_check/*.run
oda/ZED_M_Depth_check/*.whl
oda/ZED_M_Depth_check/finetune_V5/dataset/
oda/ZED_M_Depth_check/finetune_V5/output/
oda/ZED_M_Depth_check/finetune_V5/runs/
oda/ZED_M_Depth_check/finetune_V5/model/
oda/ZED_M_Depth_check/**/*.pt

# --- Runtime debug captures (never commit these; see chore/prune-non-okra) ---
seat_finder_debug/
*_debug/
*_detected.jpg
*_input.jpg
